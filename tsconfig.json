{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@server/*": [
        "./server/*"
      ],
      "@database/*": [
        "./database/*"
      ]
    }
  },
  "include": [
    "server/**/*.ts",
    "database/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "client",
    "database/data"
  ]
}
