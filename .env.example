HOST=127.0.0.1
PORT=3001
CLIENT_PORT=5173
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=database/data/ma-shop.sqlite
SESSION_DAYS=7
ADMIN_NAME=Chủ shop M&A
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gửi email đặt lại mật khẩu (SMTP). Copy file này thành .env rồi điền thật.
# Gmail: bật xác minh 2 bước + Mật khẩu ứng dụng.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Tính năng mở rộng ---
# Thư mục lưu ảnh sản phẩm tải lên (được phục vụ tại /uploads).
UPLOAD_DIR=uploads
# Thanh toán: 0 = stub (mặc định), 1 = bật cổng thật (chưa tích hợp). Webhook luôn cần chữ ký HMAC-SHA256 (header x-signature).
PAYMENTS_LIVE=0
PAYMENT_WEBHOOK_SECRET=
SHIPPING_WEBHOOK_SECRET=
# OTP_MODE=test chỉ hiệu lực khi NODE_ENV khác production: cho phép mã cố định 000000.
OTP_MODE=
